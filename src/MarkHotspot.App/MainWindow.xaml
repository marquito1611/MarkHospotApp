<Window x:Class="MarkHotspot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MarkHotspot" Height="760" Width="1120" MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource MainTextBrush}">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                    <TextBlock Text="MARK" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Hotspot" FontSize="27" FontWeight="Bold"/>
                    <TextBlock Text="NETWORK CONTROL" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel>
                    <Border Background="#2A2D32" CornerRadius="9" Padding="12" Margin="0,0,0,8">
                        <TextBlock Text="◉   Panel principal" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="▦   Dispositivos" Padding="12" Margin="0,0,0,8" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="⇅   Control de tráfico" Padding="12" Margin="0,0,0,8" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="⊘   Lista negra" Padding="12" Margin="0,0,0,8" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="⚙   Configuración" Padding="12" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Margin="0,12"/>
                    <TextBlock Text="MarkHotspot" FontWeight="SemiBold"/>
                    <TextBlock Text="Creada por GitHub: @marquito1611" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Panel principal" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Estado de red y punto de acceso" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22"/>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PUNTO DE ACCESO WI-FI" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="HotspotStateText" Text="Estado sin verificar" FontSize="24" FontWeight="Bold" Margin="0,8,0,4"/>
                            <TextBlock x:Name="HotspotDetailText" Text="La detección inicial de adaptadores se está preparando." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="RefreshButton" Content="Actualizar red" VerticalAlignment="Center" Click="RefreshButton_Click"/>
                    </Grid>
                </Border>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="20">
                        <StackPanel>
                            <TextBlock Text="ADAPTADORES DE RED" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="AdapterCountText" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                            <TextBlock Text="Interfaces detectadas en Windows" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="20">
                        <StackPanel>
                            <TextBlock Text="CLIENTES" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="Pendiente" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/>
                            <TextBlock Text="Requiere integrar detección real del hotspot" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Interfaces de red" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <ListView x:Name="AdaptersList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MainTextBrush}" MinHeight="170">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Nombre" DisplayMemberBinding="{Binding Name}" Width="230"/>
                                    <GridViewColumn Header="Tipo" DisplayMemberBinding="{Binding Type}" Width="120"/>
                                    <GridViewColumn Header="Estado" DisplayMemberBinding="{Binding Status}" Width="100"/>
                                    <GridViewColumn Header="Velocidad" DisplayMemberBinding="{Binding Speed}" Width="110"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock Text="Aviso: esta versión inicial todavía no activa el hotspot ni controla tráfico. No se presentan esas funciones como operativas." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
