<Window x:Class="MarkHotspot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MarkHotspot" Icon="Assets/MarkHotspotApp.ico" Height="820" Width="1160" MinHeight="680" MinWidth="940"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource MainTextBrush}">
    <Grid Margin="24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                    <TextBlock Text="MARK" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Hotspot" FontSize="27" FontWeight="Bold"/>
                    <TextBlock Text="NETWORK CONTROL" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel>
                    <Button x:Name="HomeNavButton" Content="◉   Panel principal" Style="{StaticResource NavButtonStyle}" Click="HomeNav_Click"/>
                    <Button x:Name="DevicesNavButton" Content="▦   Dispositivos" Style="{StaticResource NavButtonStyle}" Click="DevicesNav_Click"/>
                    <Button x:Name="TrafficNavButton" Content="⇅   Control de tráfico" Style="{StaticResource NavButtonStyle}" Click="TrafficNav_Click"/>
                    <Button x:Name="BlacklistNavButton" Content="⊘   Lista negra" Style="{StaticResource NavButtonStyle}" Click="BlacklistNav_Click"/>
                    <Button x:Name="SettingsNavButton" Content="⚙   Configuración" Style="{StaticResource NavButtonStyle}" Click="SettingsNav_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom"><Separator Margin="0,12"/><TextBlock Text="MarkHotspot" FontWeight="SemiBold"/><TextBlock Text="Creada por GitHub: @marquito1611" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel x:Name="HomePage">
                <TextBlock Text="Panel principal" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Estado de red y punto de acceso" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22"/>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="PUNTO DE ACCESO WI-FI" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="HotspotStateText" Text="Estado sin verificar" FontSize="24" FontWeight="Bold" Margin="0,8,0,4"/>
                        <TextBlock x:Name="HotspotDetailText" Text="Preparando diagnóstico de red…" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <WrapPanel><Button x:Name="StartButton" Content="Iniciar hotspot heredado" Click="StartButton_Click"/><Button x:Name="StopButton" Content="Detener hotspot" Click="StopButton_Click"/><Button x:Name="RefreshButton" Content="Actualizar red" Click="RefreshButton_Click"/></WrapPanel>
                    </StackPanel>
                </Border>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="20">
                        <StackPanel><TextBlock Text="ADAPTADORES DE RED" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="AdapterCountText" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="Interfaces detectadas en Windows" Foreground="{StaticResource MutedBrush}" FontSize="12"/></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="20">
                        <StackPanel><TextBlock Text="CONFIGURACIÓN WI-FI" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="SSID y contraseña" FontSize="19" FontWeight="Bold" Margin="0,8,0,12"/><TextBlock Text="Nombre de red" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/><TextBox x:Name="SsidBox" Text="MarkHotspot" Padding="8" Margin="0,0,0,10"/><TextBlock Text="Contraseña (8–63 caracteres)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/><Grid><PasswordBox x:Name="PasswordBox" Password="ChangeMe123" Padding="8" Margin="0,0,36,0"/><TextBox x:Name="PasswordVisibleBox" Text="ChangeMe123" Padding="8" Margin="0,0,36,0" Visibility="Collapsed"/><Button x:Name="TogglePasswordButton" Content="◉" Width="32" Height="30" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0" ToolTip="Mostrar u ocultar contraseña" Click="TogglePasswordButton_Click"/></Grid></StackPanel>
                    </Border>
                </Grid>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="20">
                    <StackPanel><TextBlock Text="Interfaces de red" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <ListView x:Name="AdaptersList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MainTextBrush}" MinHeight="150" MaxHeight="220">
                            <ListView.View><GridView><GridViewColumn Header="Nombre" DisplayMemberBinding="{Binding Name}" Width="230"/><GridViewColumn Header="Tipo" DisplayMemberBinding="{Binding Type}" Width="120"/><GridViewColumn Header="Estado" DisplayMemberBinding="{Binding Status}" Width="100"/><GridViewColumn Header="Velocidad" DisplayMemberBinding="{Binding Speed}" Width="110"/></GridView></ListView.View>
                        </ListView>
                        <TextBlock Text="El inicio del punto de acceso usa Hosted Network heredado. El control de tráfico por dispositivo y el bloqueo efectivo del tráfico reenviado todavía requieren un motor de filtrado compatible y pruebas en Windows." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                </StackPanel>
                <StackPanel x:Name="DevicesPage" Visibility="Collapsed">
                    <TextBlock Text="Dispositivos" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Solo clientes de la red local del hotspot" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22"/>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Dispositivos detectados" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Lectura de vecinos IPv4 de Windows; no todos los equipos responden a la búsqueda." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="DevicesCountText" Text="0" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/><Button x:Name="ScanDevicesButton" Content="Buscar dispositivos" Click="ScanDevicesButton_Click"/></StackPanel></Grid>
                        <ListView x:Name="DevicesList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MainTextBrush}" MinHeight="150" MaxHeight="240">
                            <ListView.View><GridView><GridViewColumn Header="Dirección IP" DisplayMemberBinding="{Binding Ip}" Width="150"/><GridViewColumn Header="Dirección MAC" DisplayMemberBinding="{Binding Mac}" Width="190"/><GridViewColumn Header="Estado" DisplayMemberBinding="{Binding State}" Width="140"/></GridView></ListView.View>
                        </ListView>
                        <WrapPanel Margin="0,10,0,0"><Button x:Name="AddToBlacklistButton" Content="Bloquear dispositivo seleccionado" Click="AddToBlacklistButton_Click"/></WrapPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
                <StackPanel x:Name="BlacklistPage" Visibility="Collapsed">
                    <TextBlock Text="Lista negra" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Dispositivos guardados para bloquear" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22"/>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Lista negra" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Se guarda en la configuración local. Las reglas de Firewall del equipo no garantizan bloquear el tráfico reenviado del hotspot." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" x:Name="BlacklistCountText" Text="0" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                        <ListView x:Name="BlacklistList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MainTextBrush}" MinHeight="100" MaxHeight="200">
                            <ListView.View><GridView><GridViewColumn Header="Dirección IP" DisplayMemberBinding="{Binding Ip}" Width="150"/><GridViewColumn Header="Dirección MAC" DisplayMemberBinding="{Binding Mac}" Width="190"/><GridViewColumn Header="Añadido" DisplayMemberBinding="{Binding AddedAt}" Width="150"/></GridView></ListView.View>
                        </ListView>
                        <WrapPanel Margin="0,10,0,0"><Button x:Name="RemoveFromBlacklistButton" Content="Quitar de lista negra" Click="RemoveFromBlacklistButton_Click"/></WrapPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
                <StackPanel x:Name="TrafficPage" Visibility="Collapsed">
                    <TextBlock Text="Control de tráfico" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Administración del ancho de banda" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22"/>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22">
                        <StackPanel>
                            <TextBlock Text="Límites por dispositivo" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Esta versión aún no aplica límites reales de subida y bajada. Windows Mobile Hotspot no ofrece un control por cliente desde esta interfaz; para que los valores tengan efecto hace falta integrar un motor de filtrado y shaping de tráfico." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,18"/>
                            <TextBlock Text="Estado" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="No configurado: límites no aplicados" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
                    <TextBlock Text="Configuración" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Ajustes del punto de acceso" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22"/>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22">
                        <StackPanel>
                            <TextBlock Text="Nombre de red (SSID)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/>
                            <TextBox x:Name="SettingsSsidBox" Padding="8" Margin="0,0,0,12" Text="MarkHotspot"/>
                            <TextBlock Text="Contraseña" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/>
                            <TextBlock Text="Guarda aquí el nombre de red. Para cambiar la contraseña, usa el campo del Panel principal." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/><Button Content="Guardar nombre de red" Click="SaveSettingsButton_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Temas" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="Elige la apariencia de MarkHotspot. Solo puede estar activo un tema a la vez." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Claro" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Fondo blanco y detalles azules" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                                <ToggleButton x:Name="LightThemeToggle" Grid.Column="1" Style="{StaticResource ThemeSwitchStyle}" VerticalAlignment="Center" Checked="LightThemeToggle_Checked" Unchecked="LightThemeToggle_Unchecked"/>
                            </Grid>
                            <Separator Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Oscuro" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Colores oscuros actuales" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                                <ToggleButton x:Name="DarkThemeToggle" Grid.Column="1" Style="{StaticResource ThemeSwitchStyle}" VerticalAlignment="Center" Checked="DarkThemeToggle_Checked" Unchecked="DarkThemeToggle_Unchecked"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>